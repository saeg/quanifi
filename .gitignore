# Reports (generated output — keep the folder, not the files)
reports/*.html

# Secrets / env
.env
.env.*
token_iqm_usp.txt
token_iqm_*.txt
token_*iqm*.txt
*.pem
*.key

# Local Django development database
db.sqlite3

# collectstatic output (STATIC_ROOT); regenerate with `manage.py collectstatic`
var/

# Terraform local state and per-environment values
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
!*.tfvars.example

# Large HTML guides (binary-ish, not source)
"NiFi Developer's Guide.html"
"NiFi Python Developer's Guide.html"
reports/tmp/*
reports/*.json
reports-archive/
experiments/out/

# transient Chrome profile from tools/nifi_screenshot.py
docs/screenshots/*.chrome-profile/

# Provider credentials. Kept 0600 on disk and loaded into NiFi's environment by
# `just nifi-start`; never committed. A credential in a flow file is a
# credential in a git repo, and the same goes for the files it is read from.
ibm_api_key.txt
token_iqm.txt

# Personal IQM token exports. The existing token_* rules are prefix-anchored and
# do not catch a file named <person>.token.iqm.txt, so match the token anywhere
# in the name.
*token*iqm*.txt
*token*IQM*.txt

# Runtime coordination only; the file contains no campaign evidence.

# Open Quantum SDK service-account key (secret; path only in .env)
sdk-key-openquantum*.json

# Open Quantum side-study: plan.json is a 4.3MB deterministic rebuild, guarded
# by manifest_sha256 and regenerated by `just oq-preflight`. The preflight /
# submitted / collected evidence beside it IS tracked.
experiments/results/openquantum/*/plan.json

# Credential files kept in the working tree. Path only, never contents.
api_key_*.txt
ibm_key_*.json
new_iqm_token_*.txt

# IBM Quantum API key exports downloaded from the console. The console names the
# file after the key ("token ibm  key <name>.json"), so the existing
# ibm_key_*.json rule above does not catch it. Spaces are intentional.
token*ibm*key*.json
token*IBM*key*.json
*ibm*api*key*.json

# Docker quickstart output (bind-mounted into the NiFi container) and the
# headless run of tools/build_grover_examples.py.
reports/quickstart/
reports/quickstart-local/
reports/h2-vqe/
reports/h2-vqe-local/
